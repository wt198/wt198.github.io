---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags ?? []))];
---

<BaseLayout title="博客">
  <section class="section">
    <h1>博客文章</h1>
    <p style="color: var(--color-text-secondary); margin: 8px 0 24px;">
      共 {allPosts.length} 篇文章
    </p>

    {allTags.length > 0 && (
      <div style="margin-bottom: 24px; display: flex; gap: 8px; flex-wrap: wrap;">
        {allTags.map((tag) => (
          <span class="tag" style="cursor: default;">{tag}</span>
        ))}
      </div>
    )}

    <ul class="post-list">
      {allPosts.map((post) => (
        <li class="post-item">
          <div>
            {post.data.tags?.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </div>
          <span class="date">{post.data.date}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
